# Configuración para Backend - Módulo de Automatizaciones

PORT=PORT
NODE_ENV=development

# ------------------------------------------------------------------
# MODO 1: Desarrollo Local con Docker Compose Dev (Recomendado)
# Conexión directa al contenedor PostgreSQL local
# ------------------------------------------------------------------
DB_HOST=HOST
DB_PORT=PORT
DB_NAME=DATABASE
DB_USER=USER
DB_PASSWORD=PASSWORD

# ------------------------------------------------------------------
# MODO 2: Desarrollo Local con Túnel SSH a Servidor Remoto (192.168.20.206)
# Abrir túnel antes: ssh -L 5433:localhost:5432 agente_ia@192.168.20.206
# ------------------------------------------------------------------
# DB_HOST=HOST
# DB_PORT=PORT
# DB_NAME=DATABASE
# DB_USER=USER
# DB_PASSWORD=PASSWORD

# ------------------------------------------------------------------
# Pool de PostgreSQL (opcional; todos tienen default seguro)
# statement_timeout es provisional/global (ms); subir por env si una operación
# legítima lo excede. query_timeout=0 = desactivado. SSL es opt-in: si se pone
# DB_SSL_ENABLED=true hay que dar DB_SSL_CA (PEM de la CA); nunca se desactiva
# la validación del certificado.
# ------------------------------------------------------------------
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=0
DB_SSL_ENABLED=false
DB_SSL_CA=

# Autenticación y Seguridad
# JWT_SECRET firma la cookie de sesión. Generar con: openssl rand -hex 32
JWT_SECRET=SECRET
JWT_EXPIRES_IN=8h
COOKIE_NAME=COOKIE_NAME
CSRF_COOKIE_NAME=CSRF_COOKIE_NAME
COOKIE_SECURE=false

# CORS Local
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API Key Sinay (Opcional en desarrollo)
# Catálogo SCAC y tracking de contenedores de compras internacionales.
SINAY_API_KEY=APIKEY

# ------------------------------------------------------------------
# Webhooks de n8n (todos opcionales)
# Sin configurar, el trigger responde `skipped` y la operación sigue adelante:
# el portal funciona sin notificar. INTERNATIONAL_PURCHASES_REGISTRATION_BASE_URL
# es la base del enlace que recibe el forwarder; en producción hay que ponerla,
# porque el forwarder abre el enlace desde fuera de la red de la empresa y el
# primer origen de FRONTEND_ORIGINS (el fallback) puede ser una IP interna.
# N8N_WEBHOOK_AUTH_TOKEN protege el webhook ENTRANTE de revaluaciones
# (POST /api/material-revaluations/notify); sin él, esa ruta responde 503.
# ------------------------------------------------------------------
# N8N_INTERNATIONAL_PURCHASES_WEBHOOK_URL=
# N8N_MATERIAL_REVALUATION_WEBHOOK_URL=
# N8N_FORWARDER_INVITE_WEBHOOK_URL=
# N8N_WEBHOOK_TIMEOUT_MS=10000
# N8N_WEBHOOK_AUTH_HEADER=X-Webhook-Token
# N8N_WEBHOOK_AUTH_TOKEN=
# INTERNATIONAL_PURCHASES_REGISTRATION_BASE_URL=

# SAP Service Layer (Opcional)
# Solo lo usan los usuarios con auth_source='sap' en audit_portal.users: su
# contraseña se valida contra SAP en vez de contra el hash local. Sin estas dos
# variables, esos usuarios NO pueden entrar —reciben "La autenticación con SAP no
# está disponible"—; los de auth_source='local' no se ven afectados.
# El Service Layer solo verifica credenciales: no mantiene sesión (se hace Login y
# Logout inmediato para no consumir sesiones concurrentes de la licencia), y la
# sesión única por usuario la controla audit_portal.user_sessions, no SAP.
# SAP_SERVICE_LAYER_URL=https://192.168.x.x:50000/b1s/v1
# SAP_COMPANY_DB=COMPANY_DB
# SAP_LOGIN_TIMEOUT_MS=10000
